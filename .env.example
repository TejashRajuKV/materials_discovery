# Copy to .env and export before starting the backend (the app reads process.env).
PORT=3000
DB_PATH=database/materials.db
PYTHON_BIN=python3          # use `python` on Windows
ML_TIMEOUT_MS=120000
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PREDICT=60       # requests per minute per IP
RATE_LIMIT_DISCOVERY=10
CORS_ORIGIN=http://localhost:5173
