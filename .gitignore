# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Build output
dist/
build/
.vite/

# Environment
.env
.env.*
!.env.example

# Database (keep schema, ignore local data)
database/*.db
database/*.db-journal
database/*.db-shm
database/*.db-wal
database/backups/*
!database/backups/.gitkeep

# ML artifacts
ml/models/saved/*
!ml/models/saved/.gitkeep
ml/data/raw/*
!ml/data/raw/.gitkeep
# slim CSV written by scripts/data/download_jarvis.py (a few MB) may be committed
!ml/data/raw/jarvis_*.csv
ml/data/processed/*
!ml/data/processed/.gitkeep
ml/data/external/*
!ml/data/external/.gitkeep

# Experiment outputs
experiments/*/**
!experiments/*/.gitkeep
!experiments/results/.gitkeep

# Logs & OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Raw JARVIS dumps are 150 MB - 1.8 GB; GitHub rejects files over 100 MB
**/dft_3d*.json*
**/cfid_3d*.json*
**/mp_3d*.json*
**/oqmd_3d*.json*
*.json.zip
